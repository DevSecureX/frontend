# DevSecureX Frontend Environment Variables Example
# Copy this file to .env and update with your actual values for local development
# For production deployment, see .env.production

# API Configuration - Local backend server
VITE_API_BASE_URL=http://localhost:8010
VITE_API_VERSION=v1
VITE_APP_ENV=development

# Feature Flags - Adjust based on your needs
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_FEEDBACK=true
VITE_ENABLE_REAL_TIME=true

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_SW_ENABLED=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_INSTALL_PROMPT=true
VITE_ENABLE_AUTO_UPDATE=true
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# External Service IDs
# Create development OAuth apps with http://localhost:5173 redirect URLs
VITE_GITHUB_CLIENT_ID=your_dev_github_client_id
VITE_GOOGLE_CLIENT_ID=your_dev_google_client_id
VITE_RAZORPAY_KEY_ID=your_test_razorpay_key_id

# WebSocket URL for real-time features
VITE_SOCKET_URL=ws://localhost:8010

# Firebase Configuration (for production builds)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_DOMAIN=your-project-id.web.app